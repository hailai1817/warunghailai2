rules_version = '2';

// Test / demo mode: allow read + write for everyone until the set deadline.
// Everything is public (products, transactions, settings, reviews) so anyone
// who has the app can read and change the data. Do NOT use in production.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2027, 12, 31);
    }
  }
}